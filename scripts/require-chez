#!/bin/sh
# scripts/require-chez GOAL CHEZ
# scripts/require-chez --any GOAL CHEZ
# scripts/require-chez --find NAME...
#
# Asks CHEZ what it is by running it once on a program that prints one
# line, `chez-scheme MAJOR.MINOR.SUB threaded` (or `nothreads`), and
# nothing else. No other Scheme prints it: the program needs Chez's own
# scheme-version-number and threaded?. A REPL that meets an error goes on
# to its end and exits 0, so it is the line, not the exit, that tells.
#
# GOAL CHEZ: refuses, before a make recipe runs Chez, a CHEZ that is not
# Chez Scheme 10.4.1 or later, threaded: chez-http-server's floor
# (ADR-0002). The Makefile passes it $(GOAL), what the user typed, as
# scripts/require-tools takes it.
#
# --any GOAL CHEZ: refuses a CHEZ that is not Chez Scheme, of any version,
# threaded or not: for the docs site's targets, which load neither the
# server nor libuv, and which CI's site job and the Pages workflow run on
# apt's Chez, below the floor.
#
# A refusal is one line on stderr, naming what CHEZ is and what is needed,
# then a hint line, and exit 2. Silent, and exit 0, when CHEZ will do.
#
# --find NAME...: prints the first NAME on PATH that is Chez Scheme, of any
# version, else the first NAME on PATH, else the first NAME, and exits 0:
# the Makefile's default CHEZ, which the checks above then hold.
#
# It needs nothing but shell builtins and CHEZ itself, so /bin/sh runs it
# with no PATH of its own. A version is compared digit by digit, never as a
# shell number, so a component of any length compares as it should.
set -u

floor_major=10
floor_minor=4
floor_sub=1
floor=$floor_major.$floor_minor.$floor_sub

usage() {
  echo "usage: require-chez [--any] GOAL CHEZ | require-chez --find NAME..." >&2
  exit 2
}

nl='
'

# program: what the probe asks, as one line: Chez's version and build.
program='(call-with-values scheme-version-number
  (lambda (major minor sub)
    (display "chez-scheme ")
    (display major) (display ".") (display minor) (display ".") (display sub)
    (display (if (threaded?) " threaded" " nothreads"))
    (newline)))'

# probe CHEZ: runs it once on the program, setting out, all it wrote to
# stdout and stderr, less its last line feeds, and code, its exit status.
# The program goes to Chez's REPL on stdin, which -q keeps from printing a
# greeting or a prompt. Not --script /dev/stdin: Chez 10.2 asks a script's
# port its position, which a pipe refuses. A CHEZ that exits unread may
# leave printf a closed pipe, whose complaint is no part of the answer.
probe() {
  out=$(printf '%s\n' "$program" 2>/dev/null | "$1" -q 2>&1)
  code=$?
}

# digits S: whether S is one or more of 0 to 9, and nothing else.
digits() {
  case $1 in
    '' | *[!0-9]*) return 1 ;;
  esac
  return 0
}

# parse: whether $out is the program's line, exactly, and CHEZ exited 0.
# The words around the version are fixed, so anything more, a second line
# among it, lands in the version, which must be three runs of digits
# between two dots. Sets version, major, minor, sub and threads.
parse() {
  case $out in
    "chez-scheme "*" threaded") threads=threaded ;;
    "chez-scheme "*" nothreads") threads=nothreads ;;
    *) return 1 ;;
  esac
  [ "$code" -eq 0 ] || return 1
  version=${out#chez-scheme }
  version=${version% *}
  case $version in
    *.*.*) ;;
    *) return 1 ;;
  esac
  major=${version%%.*}
  rest=${version#*.}
  minor=${rest%%.*}
  sub=${rest#*.}
  digits "$major" && digits "$minor" && digits "$sub"
}

# unpadded S: S without its leading zeros, or 0.
unpadded() {
  s=$1
  while [ "${#s}" -gt 1 ] && [ "${s#0}" != "$s" ]; do s=${s#0}; done
  printf '%s' "$s"
}

# compare A B: prints lt, eq or gt for the digit strings A and B, of any
# length: the longer is the greater, and two of one length compare digit
# by digit from the left.
compare() {
  a=$(unpadded "$1")
  b=$(unpadded "$2")
  if [ "${#a}" -lt "${#b}" ]; then echo lt; return; fi
  if [ "${#a}" -gt "${#b}" ]; then echo gt; return; fi
  while [ -n "$a" ]; do
    da=${a%"${a#?}"}
    db=${b%"${b#?}"}
    if [ "$da" -lt "$db" ]; then echo lt; return; fi
    if [ "$da" -gt "$db" ]; then echo gt; return; fi
    a=${a#?}
    b=${b#?}
  done
  echo eq
}

# at_floor: whether major.minor.sub is the floor or later.
at_floor() {
  c=$(compare "$major" "$floor_major")
  [ "$c" = gt ] && return 0
  [ "$c" = lt ] && return 1
  c=$(compare "$minor" "$floor_minor")
  [ "$c" = gt ] && return 0
  [ "$c" = lt ] && return 1
  [ "$(compare "$sub" "$floor_sub")" != lt ]
}

# hint NEEDS: a refusal's last line.
hint() {
  if command -v guix >/dev/null 2>&1 && [ -z "${GUIX_ENVIRONMENT:-}" ]; then
    echo "On this Guix host, run it in the project's container: scripts/guix-env make $goal" >&2
  else
    echo "Install $1, or name one with CHEZ=/path/to/scheme, then run make $goal again." >&2
  fi
}

mode=floor
case ${1:-} in
  --find)
    shift
    [ "$#" -ge 1 ] || usage
    first_found=
    for name in "$@"; do
      command -v "$name" >/dev/null 2>&1 || continue
      [ -n "$first_found" ] || first_found=$name
      probe "$name"
      if parse; then
        printf '%s\n' "$name"
        exit 0
      fi
    done
    printf '%s\n' "${first_found:-$1}"
    exit 0
    ;;
  --any)
    mode=any
    shift
    ;;
esac

[ "$#" -eq 2 ] || usage
goal=$1
chez=$2

if [ "$mode" = any ]; then
  needs="Chez Scheme"
  wanted="the docs site needs Chez Scheme"
else
  needs="Chez Scheme $floor or later, threaded"
  wanted="circuit needs Chez Scheme $floor or later, threaded"
fi

if [ -z "$chez" ] || ! command -v "$chez" >/dev/null 2>&1; then
  echo "make $goal: CHEZ=$chez not found; $wanted." >&2
  hint "$needs"
  exit 2
fi

probe "$chez"

if ! parse; then
  first=${out%%"$nl"*}
  if [ -z "$out" ]; then
    answering=nothing
  elif [ "$first" = "$out" ]; then
    answering="'$first'"
  else
    answering="'$first' and more"
  fi
  echo "make $goal: CHEZ=$chez is not Chez Scheme: asked for its version, it exited $code, answering $answering; $wanted." >&2
  hint "$needs"
  exit 2
fi

[ "$mode" = any ] && exit 0

if at_floor && [ "$threads" = threaded ]; then
  exit 0
fi

if [ "$threads" = threaded ]; then
  build=threaded
else
  build="not threaded"
fi
echo "make $goal: CHEZ=$chez is Chez Scheme $version, $build; $wanted." >&2
hint "$needs"
exit 2
