# build artifacts: the SRFI-64 link tree and anything else we generate
/build/

# the dependencies `make fetch` fetches, as Akku.lock pins them; outside
# build/, so `make clean` keeps them
/vendor/akku/
/vendor/akku-trees/

# the old submodules, which a checkout from before each came from Akku
# keeps: jsonparse's, the server's and chez-websocket's. Not on the path,
# and never to be added back as gitlinks
/vendor/jsonparse/
/vendor/chez-http-server/
/vendor/chez-websocket/

# Chez compiled objects / whole-program optimization outputs
*.so
*.wpo

# plugin scratch
/.superpowers/

# linked worktrees made under the checkout
/.claude/worktrees/
